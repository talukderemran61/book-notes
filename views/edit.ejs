<%- include('partials/header.ejs') %>
<main>
    <div>
        <a href="/" class="text-sm text-gray-500 hover:underline">
            ← Back
        </a>

        <h1 class="text-2xl font-bold mt-4 mb-6">
            Edit Book
        </h1>
        <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" alt="cover">

        <form class="space-y-4" action="/edit/<%= book.id %>" method="POST">

            <div>
                <label for="title">Title: </label>
                <input class="w-full border p-2 rounded" name="title" value="<%= book.title %>" required>
            </div>

            <div>
                <label for="author">Author: </label>
                <input class="w-full border p-2 rounded" name="author" value="<%= book.author %>">
            </div>

            <div>
                <label for="rating">Rating: </label>
                <input class="w-full border p-2 rounded" type="number" step="0.5" name="rating" min="1" max="10" value="<%= book.rating %>">
            </div>

            <div>
                <label for="isbn">ISBN: </label>
                <input class="w-full border p-2 rounded" name="isbn" value="<%= book.isbn %>">
            </div>

            <div>
                <label for="notes">Notes: </label>
                <textarea class="w-full border p-2 rounded" name="notes"><%= book.notes %></textarea>
            </div>

            <div>
                <label for="date_read">Date Read: </label>
                <input class="w-full border p-2 rounded" type="date" name="date_read" value="<%= book.date_read.toISOString().split('T')[0] %>">
            </div>

            <button class="bg-black text-white px-4 py-2 rounded hover:bg-gray-800" type="submit">
                Update Book
            </button>

        </form>
    </div>
</main>
<%- include('partials/footer.ejs') %>