<%- include('partials/header.ejs') %>
<main>
    <div>
        <a href="/" class="text-sm text-gray-500 hover:underline">
            ← Back
        </a>
        <% if (book) { %>
            <% if (book.isbn) { %>  <!-- avoid displaying broken image icon when "isbn" field is blank --> 
                <img class="mt-6 rounded" src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" alt="cover">
            <% } %>
            <h1 class="text-3xl font-bold mt-4">
                <%= book.title %>
            </h1>
            <p class="mt-2 text-sm">
                Rating: <strong><%= book.rating %></strong>/10
            </p>
            <p class="mt-2 text-sm">
                ISBN: <%= book.isbn %>
            </p>
            <p class="mt-2 text-sm">
                Date read: <%= book.date_read %>
            </p>
            <p class="mt-6">
                <pre class="leading-relaxed text-gray-800 whitespace-pre-line"><%= book.notes %></pre>
            </p>
        <% } else { %>
            <p>Book doesn't exist in Database.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer.ejs') %>