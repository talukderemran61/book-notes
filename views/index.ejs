<%- include('partials/header.ejs') %>
<main>
    <div>
        <p>Sort by:</p>
        <a href="/?sort=recent">Recent</a>
        <a href="/?sort=rating">Rating</a>
        <a href="/?sort=title">Title</a>
    </div>
    <hr>
    <div>
        <a href="/add">Add New Books</a>
    </div>
    <hr>

    <% books.forEach(book=> { %>
        <div>
            <% if (book.isbn) { %>  <!-- avoid displaying broken image icon when "isbn" field is blank --> 
                <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" alt="cover">
            <% } %>

            <h2>
                <%= book.title %> - by <%= book.author %>
            </h2>

            <p>
                Rating: <b><%= book.rating %></b>/10
            </p>

            <p>
                <strong>Notes:</strong> <%= book.notes.slice(0, 150) %>... <a href="/book/<%= book.id %>">Read more.</a>
            </p>

            <div style="display: flex; gap: 20px;">
                <a href="/edit/<%= book.id %>">Edit</a>

                <form action="/delete/<%= book.id %>" method="post" onclick="return confirm('Delete this book?')">
                    <!-- 'confirm' js funtion is used to handle any accidental click on 'delete' button -->
                    <button type="submit">Delete</button>
                </form>
            </div>
            <hr>
        </div>
    <% }) %>
</main>
<%- include('partials/footer.ejs') %>