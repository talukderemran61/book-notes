<%- include('partials/header.ejs') %>
<main>
    <div>
        <a href="/" class="text-sm text-gray-500 hover:underline">
            ← Back
        </a>
        <h1 class="text-2xl font-bold mt-4 mb-6">
            Add a New Book
        </h1>

        <form class="space-y-4" action="/add" method="post">
            <input class="w-full border p-2 rounded" id="title" type="text" name="title" placeholder="Title">
            <input class="w-full border p-2 rounded" id="author" type="text" name="author" placeholder="Author">
            <input class="w-full border p-2 rounded" id="rating" type="number" step="0.5" name="rating" min="1" max="10" placeholder="Rating (1-10)">
            <input class="w-full border p-2 rounded" id="isbn" type="text" name="isbn" placeholder="ISBN">
            <textarea class="w-full border p-2 rounded" id="notes" name="notes" placeholder="Your notes..."></textarea>

            <label for="date_read">
                Date read: 
                <input class="w-full border p-2 rounded" id="date_read" type="date" name="date_read">
            </label>
            <button class="bg-black text-white px-4 py-2 rounded hover:bg-gray-800" type="submit">Add Book</button>
        </form>
    </div>
</main>
<%- include('partials/footer.ejs') %>